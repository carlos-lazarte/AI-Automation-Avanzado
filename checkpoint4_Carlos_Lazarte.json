    {
      "parameters": {
        "jsCode": "const source = $('AI Triage Email - Groq1').first().json;\n\nconst raw = $json.text ?? $json.output ?? $json.response ?? '';\n\nlet d;\n\ntry {\n  d = JSON.parse(\n    String(raw)\n      .replace(/^```json\\s*/i, '')\n      .replace(/```$/, '')\n      .trim()\n  );\n} catch (e) {\n  d = {\n    intent: 'UNKNOWN',\n    confidence: 0,\n    risk: 'MEDIUM'\n  };\n}\n\nconst allowed = ['compra', 'consulta', 'reclamo'];\n\nconst intentValue = String(d.intent ?? '')\n  .trim()\n  .toLowerCase();\n\nconst confidenceValue = Number(d.confidence ?? 0);\n\nconst confidence = Number.isFinite(confidenceValue)\n  ? Math.max(0, Math.min(1, confidenceValue))\n  : 0;\n\nconst riskValue = String(\n  d.risk ?? d.riesgo ?? 'MEDIUM'\n).trim().toUpperCase();\n\nconst risk = ['LOW', 'MEDIUM', 'HIGH'].includes(riskValue)\n  ? riskValue\n  : 'MEDIUM';\n\nreturn [{\n  json: {\n    ...source,\n    intent: allowed.includes(intentValue)\n      ? intentValue\n      : 'UNKNOWN',\n    confidence,\n    risk\n  }\n}];"
      },
